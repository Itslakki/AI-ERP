# GrowthMantra AI — Environment Configuration Template
# IMPORTANT: Never commit actual secrets or credentials to version control.
# Copy this file to .env.local for local development.

# Application Core
APP_NAME="GrowthMantra AI"
APP_ENV="local"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-secret-in-production"

# Database Configuration (PostgreSQL in production; SQLite or PostgreSQL in development)
DATABASE_URL="postgresql://app:replace_locally@localhost:5432/growthmantra?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# AI Integration (OpenAI official API via server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Google Business Profile Integration (Official Google Cloud OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/integrations/google/callback"
GOOGLE_BUSINESS_PROFILE_ENABLED="false"

# Meta WhatsApp Cloud API (Official Cloud API only)
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Private S3-Compatible Storage (Media, Exports, Document Storage)
S3_ENDPOINT=""
S3_BUCKET="growthmantra-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"

# Public Branding Configuration
NEXT_PUBLIC_APP_NAME="GrowthMantra AI"
NEXT_PUBLIC_APP_TAGLINE="Your Growth Our Mantra"
NEXT_PUBLIC_COMPANY_NAME="The Marketing Mantra"
